<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Main_Menu"
        tools:targetApi="31" >
        <activity
            android:name=".minigame.GameMenu"
            android:exported="false"
            android:label="@string/title_activity_game_menu"
            android:theme="@style/Theme.Main_Menu" />
        <activity
            android:name=".minigame.Scoreboard"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".rv_item_disp"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".tips.Tips"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".bestiary.Bestiary"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".store.Store"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".logs.Logs"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".minigame.Minigame"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>