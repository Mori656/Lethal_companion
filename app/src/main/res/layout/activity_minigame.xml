<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/Theme.Select"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".minigame.Minigame">

    <Button
        android:id="@+id/but_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="Tap to Start"
        android:gravity="center"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="432dp"
        android:layout_height="699dp"

        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/bg" />

    <ImageView
        android:id="@+id/player_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:srcCompat="@drawable/hazardsuit"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="64dp"
        tools:layout_editor_absoluteY="16dp"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/scrap_airhorn"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="460dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/airhorn"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/scrap_apparatus"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="460dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/apparatus"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/scrap_bigbolticon"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="460dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/bigbolticon"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/monster_coilhead"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="460dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/coilhead"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/monster_bunkerspider"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="460dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/bunkerspider"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/monster_ghostgirl"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="460dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ghostgirl"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move4"
        android:layout_width="81dp"
        android:layout_height="630dp"
        android:layout_marginBottom="36dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toEndOf="@+id/but_move3"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move1"
        android:layout_width="81dp"
        android:layout_height="630dp"
        android:layout_marginBottom="36dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move2"
        android:layout_width="81dp"
        android:layout_height="630dp"
        android:layout_marginBottom="36dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toEndOf="@+id/but_move1"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move3"
        android:layout_width="81dp"
        android:layout_height="630dp"
        android:layout_marginBottom="36dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toEndOf="@+id/but_move2"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move5"
        android:layout_width="81dp"
        android:layout_height="630dp"
        android:layout_marginBottom="36dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toEndOf="@+id/but_move4"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_score"
        android:layout_width="378dp"
        android:layout_height="51dp"
        android:layout_marginBottom="8dp"
        android:padding="10sp"
        android:text="Score:"
        android:textAlignment="textStart"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="20dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/text_health"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_health"
        android:layout_width="380dp"
        android:layout_height="41dp"
        android:layout_marginBottom="40dp"
        android:padding="10sp"
        android:text="Health:"
        android:textAlignment="textStart"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="20dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.506"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:background="@color/green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.818" />

</androidx.constraintlayout.widget.ConstraintLayout>