<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".minigame.Minigame">

    <Button
        android:id="@+id/but_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:onClick="back"
        android:text="back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/player_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:srcCompat="@drawable/ic_launcher_foreground"
        tools:layout_editor_absoluteX="64dp"
        tools:layout_editor_absoluteY="16dp"
        tools:visibility="visible"
        tools:ignore="MissingConstraints" />

    <ImageView
        android:id="@+id/scrap1"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="460dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@android:drawable/arrow_down_float"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move1"
        android:layout_width="70dp"
        android:layout_height="630dp"
        android:layout_marginBottom="12dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move2"
        android:layout_width="70dp"
        android:layout_height="630dp"
        android:layout_marginBottom="12dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toEndOf="@+id/but_move1"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move3"
        android:layout_width="70dp"
        android:layout_height="630dp"
        android:layout_marginBottom="12dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toEndOf="@+id/but_move2"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move4"
        android:layout_width="70dp"
        android:layout_height="630dp"
        android:layout_marginBottom="12dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toEndOf="@+id/but_move3"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_move5"
        android:layout_width="70dp"
        android:layout_height="630dp"
        android:layout_marginBottom="12dp"
        android:text="1"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_score"
        app:layout_constraintStart_toEndOf="@+id/but_move4"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_score"
        android:layout_width="332dp"
        android:layout_height="38dp"
        android:text="Score:"
        android:textAlignment="textStart"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="32dp"
        android:visibility="invisible"
        android:padding="10sp"
        app:layout_constraintBottom_toTopOf="@+id/text_health"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/text_latests_score"
        android:layout_width="197dp"
        android:layout_height="37dp"
        android:layout_marginTop="24dp"
        android:text="Your Latest Score"
        android:textAlignment="center"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/but_top" />

    <TextView
        android:id="@+id/text_nickname"
        android:layout_width="197dp"
        android:layout_height="37dp"
        android:layout_marginTop="24dp"
        android:text="Your Nickname"
        android:textAlignment="center"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/but_start" />

    <TextView
        android:id="@+id/text_best_score"
        android:layout_width="181dp"
        android:layout_height="37dp"
        android:layout_marginTop="20dp"
        android:text="Your Best Score"
        android:textAlignment="center"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/score_latest" />

    <TextView
        android:id="@+id/text_health"
        android:layout_width="332dp"
        android:layout_height="38dp"
        android:layout_marginBottom="16dp"
        android:text="Health:"
        android:textAlignment="textStart"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="32dp"
        android:visibility="invisible"
        android:padding="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/but_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="148dp"
        android:text="Start Game"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/but_top"
        android:layout_width="120dp"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:text="Top 10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_nickname" />

    <TextView
        android:id="@+id/score_latest"
        android:layout_width="305dp"
        android:layout_height="33dp"
        android:layout_marginTop="8dp"
        android:text="0"
        android:textAlignment="center"
        android:textSize="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_latests_score" />

    <TextView
        android:id="@+id/score_best"
        android:layout_width="305dp"
        android:layout_height="33dp"
        android:layout_marginTop="8dp"
        android:text="0"
        android:textAlignment="center"
        android:textSize="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_best_score" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/input_nickname"
        android:layout_width="227dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:hint="Nickname"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_nickname" />

</androidx.constraintlayout.widget.ConstraintLayout>