<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/but_minigame"
        android:layout_width="144dp"
        android:layout_height="141dp"
        android:layout_marginStart="132dp"
        android:layout_marginTop="40dp"
        android:text="Minigame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/but_logs" />

    <Button
        android:id="@+id/but_tips"
        android:layout_width="144dp"
        android:layout_height="141dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:text="Tips"
        app:layout_constraintStart_toEndOf="@+id/but_logs"
        app:layout_constraintTop_toBottomOf="@+id/but_items" />

    <Button
        android:id="@+id/but_items"
        android:layout_width="144dp"
        android:layout_height="141dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="212dp"
        android:text="Items"
        app:layout_constraintStart_toEndOf="@+id/but_bestiary"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/but_bestiary"
        android:layout_width="144dp"
        android:layout_height="141dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="212dp"
        android:text="Bestiary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/but_logs"
        android:layout_width="144dp"
        android:layout_height="141dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="40dp"
        android:text="Logs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/but_bestiary" />

</androidx.constraintlayout.widget.ConstraintLayout>