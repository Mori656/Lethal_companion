<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/Theme.Minigame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".minigame.GameMenu">

    <View
        android:id="@+id/divider"
        android:layout_width="418dp"
        android:layout_height="8dp"
        android:background="@color/green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.07" />

    <Button
        android:id="@+id/but_back"
        android:layout_width="412dp"
        android:layout_height="44dp"
        android:onClick="back"
        android:text=">back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text_latests_score"
        android:layout_width="281dp"
        android:layout_height="73dp"
        android:layout_marginTop="8dp"
        android:text="Your Latest Score"
        android:textAlignment="center"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="34dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/but_top" />

    <TextView
        android:id="@+id/text_nickname"
        android:layout_width="249dp"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="Your Nickname"
        android:textAlignment="center"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/but_start" />

    <TextView
        android:id="@+id/text_best_score"
        android:layout_width="236dp"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:text="Your Best Score"
        android:textAlignment="center"
        android:textColor="#E6E2E2"
        android:textColorHighlight="#887777"
        android:textColorHint="#EAE6E6"
        android:textColorLink="#EADADA"
        android:textSize="34dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/score_latest" />

    <Button
        android:id="@+id/but_start"
        android:layout_width="361dp"
        android:layout_height="76dp"
        android:layout_marginTop="80dp"
        android:text="Start Game"
        android:textAlignment="center"
        android:textSize="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/but_top"
        android:layout_width="396dp"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Leaderboard"
        android:textAlignment="center"
        android:textSize="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.473"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_nickname" />

    <TextView
        android:id="@+id/score_latest"
        android:layout_width="327dp"
        android:layout_height="66dp"
        android:layout_marginTop="8dp"
        android:text="0"
        android:textAlignment="center"
        android:textSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_latests_score" />

    <TextView
        android:id="@+id/score_best"
        android:layout_width="323dp"
        android:layout_height="57dp"
        android:layout_marginTop="8dp"
        android:text="0"
        android:textAlignment="center"
        android:textSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.522"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_best_score" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/input_nickname"
        android:layout_width="346dp"
        android:layout_height="75dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/inputb"
        android:fontFamily="@font/font_3270_regular"
        android:hint="Nickname"
        android:textAlignment="center"
        android:textSize="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_nickname" />

</androidx.constraintlayout.widget.ConstraintLayout>